      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    },
    "line-height": {
      "xs": { "$value": "1.1" },
      "sm": { "$value": "1.25" },
      "base": { "$value": "1.5" },
      "lg": { "$value": "1.75" },
      "heading": { "$value": "1.2" }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" },
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.375rem" },
    "lg": { "$value": "0.5rem" },
    "xl": { "$value": "0.75rem" },
    "full": { "$value": "9999px" }
  },
  "border": {
    "$type": "borderWidth",
    "hairline": { "$value": "1px" },
    "thick": { "$value": "2px" },
    "focus": { "$value": "2px" }
  },
  "elevation": {
    "$type": "boxShadow",
    "none": { "$value": "none" },
    "sm": { "$value": "0 1px 2px 0 rgba(16, 24, 40, 0.06), 0 1px 3px 0 rgba(16, 24, 40, 0.08)" },
    "md": { "$value": "0 2px 4px -1px rgba(16, 24, 40, 0.06), 0 4px 8px -2px rgba(16, 24, 40, 0.10)" },
    "lg": { "$value": "0 4px 6px -2px rgba(16, 24, 40, 0.05), 0 12px 16px -4px rgba(16, 24, 40, 0.10)" },
    "overlay": { "$value": "0 8px 24px -4px rgba(16, 24, 40, 0.18), 0 20px 48px -12px rgba(16, 24, 40, 0.24)" }
  },
  "motion": {
    "$type": "duration",
    "instant": { "$value": "0ms" },
    "fast": { "$value": "120ms" },
    "base": { "$value": "180ms" },
    "slow": { "$value": "280ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "entrance": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
    "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "opacity": {
    "$type": "opacity",
    "disabled": { "$value": "0.45" },
    "muted": { "$value": "0.65" },
    "subtle": { "$value": "0.08" }
  },
  "z-index": {
    "$type": "number",
    "base": { "$value": "0" },
    "raised": { "$value": "10" },
    "dropdown": { "$value": "1600" },
    "sticky": { "$value": "1100" },
    "overlay": { "$value": "1200" },
    "modal": { "$value": "1300" },
    "toast": { "$value": "1400" },
    "tooltip": { "$value": "1500" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" },
    "xl": { "$value": "80rem" }
  }
