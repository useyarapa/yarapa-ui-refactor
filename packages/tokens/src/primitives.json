    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },
  "typography": {
    "$type": "typography",
    "font-family": {
      "sans": { "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', 'Noto Sans Thai', 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Noto Sans Mono', monospace" }
    },
    "font-size": {
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
